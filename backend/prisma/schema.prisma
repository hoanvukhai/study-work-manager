// Prisma Schema for study-work-manager (Architecture Lan 3 Revamped - Hybrid Object)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum ObjectType {
  TASK
  NOTE
  EVENT
  REFERENCE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ObjectLifecycle {
  ACTIVE
  ARCHIVED
  TRASH
}

enum ReviewGrade {
  AGAIN
  HARD
  GOOD
  EASY
}

enum RelationType {
  RELATES_TO
  DEPENDS_ON
  REFERENCES
  PARENT_OF
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique @db.VarChar(255)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  fullName         String    @map("full_name") @db.VarChar(100)
  avatarUrl        String?   @map("avatar_url")
  role             Role      @default(USER)
  lockedAt         DateTime? @map("locked_at") @db.Timestamptz
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockoutUntil     DateTime? @map("lockout_until") @db.Timestamptz
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  spaces               Space[]
  objects              Object[]
  notifications        Notification[]
  flashcards           Flashcard[]
  flashcardReviews     FlashcardReview[]
  studySessions        StudySession[]
  notificationSettings NotificationSettings?
  adminLogs            AdminAuditLog[]       @relation("AuditAdmin")
  auditedAsTarget      AdminAuditLog[]       @relation("AuditTarget")

  @@map("users")
}

model Space {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String    @db.VarChar(100)
  description String?
  icon        String    @default("📁") @db.VarChar(50)
  color       String    @default("#6366f1") @db.VarChar(20)
  settings    Json      @default("{}")
  goal        String?
  dueDate     DateTime? @map("due_date") @db.Timestamptz
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceObjects SpaceObject[]

  @@index([userId, archivedAt])
  @@map("spaces")
}

model Object {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  type             ObjectType
  title            String          @db.VarChar(255)
  description      String?
  status           TaskStatus?
  priority         Priority?
  lifecycle        ObjectLifecycle @default(ACTIVE)
  dueDate          DateTime?       @map("due_date") @db.Timestamptz
  startAt          DateTime?       @map("start_at") @db.Timestamptz
  endAt            DateTime?       @map("end_at") @db.Timestamptz
  url              String?
  estimatedMinutes Int?            @map("estimated_minutes")
  metadata         Json            @default("{}")
  archivedAt       DateTime?       @map("archived_at") @db.Timestamptz
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceObjects  SpaceObject[]
  outgoingRel   ObjectRelation[] @relation("OutgoingRelations")
  incomingRel   ObjectRelation[] @relation("IncomingRelations")
  notifications Notification[]
  flashcards    Flashcard[]
  studySessions StudySession[]

  @@index([userId, lifecycle])
  @@index([userId, type])
  @@index([userId, dueDate])
  @@index([userId, startAt])
  @@map("objects")
}

model SpaceObject {
  id       String   @id @default(uuid()) @db.Uuid
  spaceId  String   @map("space_id") @db.Uuid
  objectId String   @map("object_id") @db.Uuid
  position Int      @default(0)
  isPinned Boolean  @default(false) @map("is_pinned")
  addedAt  DateTime @default(now()) @map("added_at") @db.Timestamptz

  space  Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  object Object @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([spaceId, objectId])
  @@index([spaceId, position])
  @@map("space_objects")
}

model ObjectRelation {
  id           String       @id @default(uuid()) @db.Uuid
  fromObjectId String       @map("from_object_id") @db.Uuid
  toObjectId   String       @map("to_object_id") @db.Uuid
  relationType RelationType @default(RELATES_TO) @map("relation_type")
  // true = tự sinh từ [[Tiêu đề]] trong nội dung; tự xoá khi không còn được nhắc
  auto         Boolean      @default(false)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  fromObject Object @relation("OutgoingRelations", fields: [fromObjectId], references: [id], onDelete: Cascade)
  toObject   Object @relation("IncomingRelations", fields: [toObjectId], references: [id], onDelete: Cascade)

  @@unique([fromObjectId, toObjectId, relationType])
  @@index([toObjectId])
  @@map("object_relations")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  objectId  String?   @map("object_id") @db.Uuid
  type      String    @default("GENERAL") @db.VarChar(50)
  title     String    @db.VarChar(255)
  message   String
  data      Json      @default("{}")
  dedupeKey String?   @map("dedupe_key") @db.VarChar(100)
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  object Object? @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, isRead])
  @@map("notifications")
}

// ---- Trụ Học tập ----

// Thẻ hỏi–đáp sinh từ Note (dòng "Câu hỏi :: Trả lời"), ôn theo SM-2.
model Flashcard {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  objectId       String    @map("object_id") @db.Uuid
  front          String    @db.VarChar(500)
  back           String    @db.VarChar(2000)
  easeFactor     Float     @default(2.5) @map("ease_factor")
  intervalDays   Int       @default(0) @map("interval_days")
  repetitions    Int       @default(0)
  dueAt          DateTime  @default(now()) @map("due_at") @db.Timestamptz
  lastReviewedAt DateTime? @map("last_reviewed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  object  Object            @relation(fields: [objectId], references: [id], onDelete: Cascade)
  reviews FlashcardReview[]

  @@unique([objectId, front])
  @@index([userId, dueAt])
  @@map("flashcards")
}

// Lịch sử mỗi lần ôn (phục vụ thống kê và chuỗi ngày học).
model FlashcardReview {
  id            String      @id @default(uuid()) @db.Uuid
  cardId        String      @map("card_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  grade         ReviewGrade
  intervalAfter Int         @map("interval_after")
  easeAfter     Float       @map("ease_after")
  reviewedAt    DateTime    @default(now()) @map("reviewed_at") @db.Timestamptz

  card Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@map("flashcard_reviews")
}

// Phiên học tập trung (Pomodoro) — thời gian học thật.
model StudySession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  objectId  String?  @map("object_id") @db.Uuid
  minutes   Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  object Object? @relation(fields: [objectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("study_sessions")
}

// ---- Thông báo ----

// Cài đặt thông báo của mỗi người dùng (1 dòng / người).
model NotificationSettings {
  userId              String  @id @map("user_id") @db.Uuid
  remindBeforeMinutes Int     @default(1440) @map("remind_before_minutes")
  quietHoursEnabled   Boolean @default(false) @map("quiet_hours_enabled")
  quietStartMinute    Int     @default(1380) @map("quiet_start_minute") // 23:00 (giờ VN)
  quietEndMinute      Int     @default(420) @map("quiet_end_minute") // 07:00 (giờ VN)
  enableDeadline      Boolean @default(true) @map("enable_deadline")
  enableOverdue       Boolean @default(true) @map("enable_overdue")
  enableEvent         Boolean @default(true) @map("enable_event")
  enableDigest        Boolean @default(true) @map("enable_digest")
  enableStudy         Boolean @default(true) @map("enable_study")
  enableUnblocked     Boolean @default(true) @map("enable_unblocked")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// ---- Quản trị ----

// Nhật ký hành động quản trị (ai khoá/mở khoá ai, phát thông báo...). Không chứa nội dung cá nhân.
model AdminAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  adminId      String   @map("admin_id") @db.Uuid
  action       String   @db.VarChar(50)
  targetUserId String?  @map("target_user_id") @db.Uuid
  detail       String   @default("") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  admin  User  @relation("AuditAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("admin_audit_logs")
}
