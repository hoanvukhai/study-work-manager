# Database connection (PostgreSQL on Docker port 5435)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5435/study_work_db?schema=public"

# JWT Secret
JWT_SECRET="study_work_manager_super_secret_jwt_key_2026"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3001

# Địa chỉ giao diện (dùng trong liên kết email đặt lại mật khẩu) và CORS (nhiều địa chỉ cách nhau bằng dấu phẩy)
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Giới hạn tần suất gọi API (số yêu cầu / phút / IP); đăng nhập, đăng ký, quên mật khẩu có giới hạn riêng
THROTTLE_LIMIT=300
THROTTLE_AUTH_LIMIT=10

# Email: để trống SMTP_HOST thì chỉ ghi liên kết đặt lại mật khẩu ra log (chế độ phát triển)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Study & Work <no-reply@example.com>"
