CORS_ORIGIN=http://localhost:3000
# Địa chỉ API mà TRÌNH DUYỆT gọi tới (được đóng vào giao diện lúc build)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Email (để trống = chỉ ghi liên kết đặt lại mật khẩu ra log của backend)
