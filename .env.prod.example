# Sao chép thành .env rồi sửa. File .env KHÔNG được đưa lên Git.
POSTGRES_PASSWORD=doi-mat-khau-nay
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
JWT_ACCESS_EXPIRES_IN=7d

# Địa chỉ công khai của giao diện (dùng trong liên kết email và CORS)
